# Source this file from Bash; it configures the existing pipeline entrypoints.
# Details and historical evidence: ../INPAINT360_RECOMMENDED.zh-CN.md
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    printf '%s\n' 'Use: source scripts/paintmesh/configs/inpaint360_recommended.env' >&2
    exit 2
fi
_paintmesh_recipe_repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)"
export DATA_ROOT="${DATA_ROOT:-${_paintmesh_recipe_repo}/data}"
export OUTPUT_ROOT="${OUTPUT_ROOT:-${_paintmesh_recipe_repo}/output}"
export PAINTMESH_ENV=paintmesh LAMA_ENV=lama
export GPU="${GPU:-1}" PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4

# Reproduce the historical bag input policy: all non-test images, quarter size
# supplied as positional argument 4. test_* RGB is reserved for evaluation.
export EVAL=false NO_DENSIFY=true DISTILL_DATA_DEVICE=cpu
export BASE_ITERATION=30000 DISTILL_ITERATION=2000
export EDGS_SAVE_ITERATIONS=30000 DISTILL_SAVE_ITERATIONS=2000

export VIRTUAL_RENDERER=edgs-pgsr VIRTUAL_CAMERA_PATH=adaptive
export VIRTUAL_CAMERA_COUNT=180
export VIRTUAL_ADAPTIVE_CONFIG="${_paintmesh_recipe_repo}/scripts/paintmesh/configs/inpaint360_adaptive180.json"
export REMOVAL_THRESHOLD=0.7 RUN_NAME=recommended_adaptive180

export PAINTMESH_INIT_MODE="${PAINTMESH_INIT_MODE:-mixed}"
case "${PAINTMESH_INIT_MODE}" in
    mixed)
        export EDGS_INPAINT_CONFIG="${_paintmesh_recipe_repo}/scripts/paintmesh/configs/inpaint360_balanced_10000.yaml"
        export EDGS_SURFACE_INIT_MODE=none
        ;;
    depth_anchor)
        export EDGS_INPAINT_CONFIG="${_paintmesh_recipe_repo}/scripts/paintmesh/configs/inpaint360_depth_anchor_10000.yaml"
        export EDGS_SURFACE_INIT_MODE=depth_anchor
        ;;
    *)
        printf '%s\n' 'PAINTMESH_INIT_MODE must be mixed or depth_anchor' >&2
        unset _paintmesh_recipe_repo
        return 2
        ;;
esac
export INPAINT_RUN_NAME="recommended_${PAINTMESH_INIT_MODE}_10000"
export INPAINT_PIPELINE=edgs-pgsr
export EDGS_INIT_USE_DEPTH=true EDGS_INIT_USE_NORMAL=false
export EDGS_TRAIN_USE_DEPTH=true EDGS_TRAIN_USE_NORMAL=true
export EDGS_INPAINT_ITERATIONS=10000
export EDGS_GEOMETRY_FROM_ITER=100 EDGS_GEOMETRY_RAMP_ITERS=2000
export EDGS_MATCH_CONFIDENCE_MIN=0.7 EDGS_MATCH_CYCLE_PIXELS=3.0
export EDGS_MATCH_REPROJECTION_PIXELS=2.0
export LOCAL_GEOMETRY_REFINE=false SUPPORT_DENSITY_MODE=legacy

# 30 is the measured bag setting, not a validated optimum for every scene.
# Override after sourcing when using a different reviewed mask policy.
export MASK_MIN_AREA=50 MASK_DILATION=30 RECURSIVE_GUIDE=false
export MAX_DEPTH=5.0 VOXEL_SIZE=0.002 NUM_CLUSTERS=1
export USE_DEPTH_FILTER=false WRITE_COLORED_MESH=true
export RENDER_INPAINT_VIDEO=false RENDER_INPAINT_TRAIN=false
export RENDER_INPAINT_TEST=false RENDER_EDGS_TEST=false WRITE_HOLE_PLY=false
unset _paintmesh_recipe_repo
